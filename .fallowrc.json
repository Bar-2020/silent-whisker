{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "__tests__/**/*.test.ts",
    "frontend/src/**/*.test.{ts,tsx}",
    "backend/**/*.test.ts",
    "scripts/*.mjs",
    "design/mocks/styles/*.css"
  ],
  "ignorePatterns": ["design/**/*.js", "design/**/*.mjs"],
  "dynamicallyLoaded": ["lint/silent-whisker-plugin.js"],
  "duplicates": {
    "mode": "strict"
  },
  "rules": {
    "css-duplicate-block": "error",
    "css-token-drift": "error",
    "css-broken-reference": "error"
  }
}
