{
  "name": "silent-whisker",
  "version": "0.1.0",
  "description": "Crowdsourced map of stray-cat feeding spots. Hebrew first, English second.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "test": "vp test run",
    "fallow": "fallow audit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run fallow && npm run lint:iac && npm run test:iac",
    "lint:iac": "bash scripts/iac-offline-checks.sh lint",
    "test:iac": "bash scripts/iac-offline-checks.sh test",
    "build": "vp build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "fallow": "^3.28.0",
    "typescript": "~6.0.3",
    "vite-plus": "1.2.0"
  }
}
