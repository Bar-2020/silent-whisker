{
  "name": "silent-whisker",
  "version": "0.1.0",
  "description": "Crowdsourced map of stray-cat feeding spots. Hebrew first, English second.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "test": "vp test run",
    "fallow": "fallow audit",
    "verify": "npm run verify:code && npm run verify:iac",
    "verify:code": "npm run typecheck && npm run lint && npm run test && npm run fallow",
    "verify:iac": "npm run lint:iac && npm run test:iac",
    "lint:iac": "bash infra/iac-offline-checks.sh lint",
    "test:iac": "bash infra/iac-offline-checks.sh test",
    "build": "npm run build -w silent-whisker-frontend",
    "design": "node design/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "fallow": "^3.28.0",
    "typescript": "~6.0.3",
    "vite-plus": "1.2.0"
  }
}
